# Predictive ML MCP (mlpredict-mcp) for Podman. Build from backend/ (the uv workspace):
#   podman build -f mlpredict-mcp/Containerfile -t ai-elevate-mlpredict:0.1.0 .
# Data and trained models are mounted read-only at /data (backend/data); see compose.yaml.
FROM docker.io/library/python:3.13-slim-bookworm

# LightGBM needs the OpenMP runtime
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.12.1

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app
COPY . .
# only this server and its workspace dependencies (menara-core, netintel-mcp), no dev tools
RUN uv sync --frozen --no-dev --package mlpredict-mcp

ENV NETINTEL_DB=/data/intel.duckdb MLPREDICT_DB=/data/ml.duckdb MLPREDICT_MODELS=/data/models PATH=/opt/venv/bin:$PATH
RUN useradd --create-home --uid 10001 app
USER app
EXPOSE 8126
CMD ["python", "-m", "mlpredict_mcp", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8126", "--search"]
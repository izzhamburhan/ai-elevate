# localhost only; check the host port before starting this independent project.
HERMES_HOST_PORT=8011
HERMES_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
HERMES_MODEL=qwen3.5:9b
# Hermes v0.21.7 needs >=64000 tokens. These settings are per-request,
# and do not restart or reconfigure the existing native Ollama service.
HERMES_CONTEXT_LENGTH=65536
HERMES_MAX_ITERATIONS=8
# Observed local Qwen specialist turns take 2-4 minutes; the Orchestrator waits for two.
HERMES_TASK_TIMEOUT_SECONDS=360
HERMES_INVESTIGATION_TIMEOUT_SECONDS=1080
NETOPS_MCP_URL=http://host.docker.internal:8000/mcp
WEATHER_MCP_URL=http://host.docker.internal:8002/mcp

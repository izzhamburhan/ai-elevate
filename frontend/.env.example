# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Local model through any OpenAI-compatible server.
# Ollama: `ollama pull gemma4:e4b` then `ollama serve` (default http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma4:e4b
# LOCAL_LLM_API_KEY=
# Context window the chat's context meter measures against (match Ollama's num_ctx; default 128000).
# LOCAL_LLM_CONTEXT_WINDOW=32768

# Built-in NetOps connector (../backend/netops-mcp), listed in the chat's Connectors dialog.
# NEXT_PUBLIC_NETOPS_MCP_URL=http://127.0.0.1:8000/mcp

# Built-in Kepler.gl Map connector; defaults to this app's /api/kepler/mcp.
# NEXT_PUBLIC_KEPLER_MCP_URL=http://localhost:3000/api/kepler/mcp

# MCP servers the agent always uses, on top of the Connectors dialog (comma-separated, streamable HTTP).
# FastMCP: `mcp.run(transport="http", port=8000)` serves at http://localhost:8000/mcp
# MCP_SERVER_URLS=http://localhost:8000/mcp
# MCP_AUTH_TOKEN=

# Optional: send chat requests to another backend (e.g. FastAPI) instead of /api/chat.
# It must accept the same body and stream the AI SDK UI message protocol.
# NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000/api/chat
